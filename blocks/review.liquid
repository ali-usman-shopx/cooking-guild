    {
      "type": "number",
      "label": "Rating",
      "id": "product_rating",
      "default": 4.7,
      "visible_if": "{{ block.settings.product_review_override }}"
    },
    {
      "type": "number",
      "label": "Count of Reviews",
      "id": "product_review_count",
      "default": 1171,
      "visible_if": "{{ block.settings.product_review_override }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.product_review_stars",
      "category": "t:categories.product"
    }
  ]
