

{% liquid
  assign block_settings = block.settings
  assign product = closest.product
  assign rating = product.metafields.reviews.rating.value.rating
  assign scale_max = product.metafields.reviews.rating.value.scale_max
  assign rating_count = product.metafields.reviews.rating_count

  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
    assign rating = product.metafields.reviews.rating.value | default: 4
    assign scale_max = product.metafields.reviews.rating.value.scale_max | default: 5
    assign rating_count = product.metafields.reviews.rating_count | default: 3
  endif

  if block_settings.store_review_override
    assign rating = block_settings.store_rating
    assign scale_max = 5
    assign rating_count = block_settings.store_review_count
  endif
  
  if block_settings.product_review_override
    assign rating = block_settings.product_rating
    assign scale_max = 5
    assign rating_count = block_settings.product_review_count
  endif
-%}

{% style %}
  .rating-wrapper-{{ block.id }} {
    --star-fill-color: {{ block_settings.star_color }};
    --star-fill-color-rgb: {{ block_settings.star_color.rgb }};
    {% if block_settings.text_color != blank %}
        --color: {{ block_settings.text_color }};
        --color-rgb: {{ block_settings.text_color.rgb }};
    {% endif %}
    {% if block_settings.override_sizes == false %}    
      --star-size: calc(var(--font-{{ block_settings.type_preset }}--size) * 1.1);
      --font-size: calc(var(--font-{{ block_settings.type_preset }}--size));
    {% else %}
      --star-size: {{block_settings.star_size}};
      --font-size: {{block_settings.font_size}};
    {% endif %}

    --rating-margin-bottom: {{ block_settings.rating_margin_bottom }};
  }

  @media screen and (max-width: 768px) {
    .rating-wrapper-{{ block.id }} {
      {% if block_settings.override_sizes %}
        --star-size: {{block_settings.star_size_mobile}};
        --font-size: {{block_settings.font_size_mobile}};
      {% endif %}
    }
  }
{% endstyle %}

{%- if rating != blank -%}
  {% liquid
    assign star_count_rating = scale_max
    assign decimal_rating = 0
    assign decimal = rating | modulo: 1

    if decimal >= 0.3 and decimal <= 0.7
      assign decimal_rating = 0.5
    elsif decimal > 0.7
      assign decimal_rating = 1
    endif

    # this is used so I can tell how many stars I need to fill. When the decimal rating above is 0.5 or 1 I count it as one as the half star is dealt with with a SVG linear gradient.
    assign decimal_rounded = decimal_rating | ceil

    assign svg_filled_stars = rating | floor | plus: decimal_rounded
  %}

  <div
    class="rating-wrapper rating-wrapper-{{ block.id }} justify-{{ block_settings.alignment }} size-style"
    style="{% render 'size-style', settings: block_settings %}"
    {{ block.shopify_attributes }}
  >
    <svg
      class="visually-hidden"
      style="width: 0; height: 0;"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 32 32"
      role="presentation"
    >
      <defs>
        <linearGradient id="half" x1="0" x2="100%" y1="0" y2="0">
          <stop offset="50%" stop-color="var(--star-fill-color)"></stop>
          <stop offset="50%" stop-color="{% if block_settings.stars_style == "outline" %}transparent{% else %}rgb(var(--star-fill-color-rgb) / var(--opacity-20){% endif %}"></stop>
        </linearGradient>

        <symbol xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" id="star">
          <path d="M31.547 12a.848.848 0 00-.677-.577l-9.427-1.376-4.224-8.532a.847.847 0 00-1.516 0l-4.218 8.534-9.427 1.355a.847.847 0 00-.467 1.467l6.823 6.664-1.612 9.375a.847.847 0 001.23.893l8.428-4.434 8.432 4.432a.847.847 0 001.229-.894l-1.615-9.373 6.822-6.665a.845.845 0 00.214-.869z" />
        </symbol>
      </defs>
    </svg>
    <div
      class="rating"
      aria-label="{{ 'accessibility.rating' | t: rating: rating }}"
    >
      {% if block_settings.stars_style == 'single' %}
        <svg
          class="stars {% if svg_filled_stars > 0 %}filled-star{% endif %}"
          viewBox="0 0 32 32"
          style="--empty-star-fill-color: rgb(var(--star-fill-color-rgb) / var(--opacity-20))"
          role="presentation"
        >
          <use xlink:href="#star"></use>
        </svg>
      {% else %}
        {%- for star in (1..star_count_rating) -%}
          <svg
            class="stars {% if star <= svg_filled_stars %}filled-star{% endif %}"
            viewBox="0 0 32 32"
            style="--empty-star-fill-color:{% if block_settings.stars_style == 'outline' %}transparent{% else %}rgb(var(--star-fill-color-rgb) / var(--opacity-20)){% endif %}"
            role="presentation"
          >
            <use xlink:href="#star"{% if decimal_rating == 0.5 and star == svg_filled_stars %} fill="url(#half)"{% endif %}></use>
            {% if block_settings.stars_style == "outline" %}
              <use xlink:href="#star" fill="none" stroke="var(--star-fill-color)" stroke-width="var(--icon-stroke-width)"></use>
            {% endif %}
          </svg>
        {%- endfor -%}
      {% endif %}
    </div>

    {%- if block_settings.show_number or block_settings.stars_style == 'single' -%}
      <p class="rating-count {{ block_settings.type_preset }}">
        {%- if block_settings.stars_style == 'single' -%}
          <span aria-hidden="true">{{- rating | round: 1 }}</span>
        {%- endif -%}
        {%- if block_settings.stars_style == 'single' and block_settings.show_number -%}
          <span class="rating-count-separator">{{ block_settings.review_count_separator }}</span>
        {%- endif -%}
        {% if block_settings.show_score_max_ratio %}
          {{ rating | round: 1 }} / {{ scale_max | times: 100 | money_without_currency }}
        {%  endif %}
        {%- if block_settings.show_number and block_settings.store_review_override == false and block_settings.product_review_override == false -%}
          {{- rating_count }}
          {{ 'content.reviews' | t }}        
        {% elsif block_settings.show_number and block_settings.product_review_override %}
          {%if block_settings.show_parenthesis %}({% endif %}&nbsp;<span style="text-decoration: underline; color: #212121">{{ rating_count}} Reviews</span>&nbsp;{%if block_settings.show_parenthesis %}){% endif %}
        {% elsif block_settings.show_number and block_settings.store_review_override %}
          {%if block_settings.show_parenthesis %}({% endif %}Over {{ rating_count | times: 100 | money_without_currency | remove: ".00" }} Happy Customers{%if block_settings.show_parenthesis %}){% endif %}
        {%- endif -%}
      </p>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .rating-wrapper {
    --star-fill-color: var(--color-foreground);
    --star-fill-color-rgb: var(--color-foreground-rgb);
    --color: var(--color-foreground);
    --color-rgb: var(--color-foreground-rgb);
    gap: var(--gap-xs);
    min-width: fit-content;
  }

  .rating-wrapper,
  .rating {
    display: flex;
    align-items: center;
  }

  .rating-wrapper.justify-right {
    flex-direction: row-reverse;
  }

  .rating {
    gap: var(--gap-3xs);
    margin-bottom: var(--rating-margin-bottom);
  }

  .rating-wrapper .rating-count,
  .rating-wrapper .rating-count-separator {
    color: var(--color);
    margin: 0;
    white-space: nowrap;
    font-size: var(--font-size);
  }

  .rating-count * {
    font-size: var(--font-size);
    font-weight: 500;
  }

  .rating-count-separator {
    opacity: var(--opacity-20);
    padding-left: calc(var(--padding-xs) / 2);
    padding-right: var(--padding-xs);
  }

  .stars {
    height: var(--star-size);
    fill: var(--empty-star-fill-color);
    align-self: center;
  }

  .filled-star {
    fill: var(--star-fill-color);
  }

  /* Custom Very Small Screen Overrides */
  @media screen and (max-width: 374px) {
    .rating-wrapper {
      flex-wrap: wrap;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_review_stars",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "override_sizes",
      "default": true,
      "info": "Enables Size Overrides",
      "label": "Override Sizes"
    },
    {
      "type": "text",
      "id": "star_size",
      "label": "Star Size",
      "default": "12px",
      "visible_if": "{{ block.settings.override_sizes }}"
    },
    {
      "type": "text",
      "id": "font_size",
      "label": "Font Size",
      "default": "14px",
      "visible_if": "{{ block.settings.override_sizes }}"
    },
    {
      "type": "text",
      "id": "star_size_mobile",
      "label": "Star Size Mobile",
      "default": "19px",
      "visible_if": "{{ block.settings.override_sizes }}"
    },
    {
      "type": "text",
      "id": "font_size_mobile",
      "label": "Font Size Mobile",
      "default": "14px",
      "visible_if": "{{ block.settings.override_sizes }}"
    },
    {
      "type": "text",
      "id": "rating_margin_bottom",
      "label": "Rating Margin Bottom",
      "default": "0px",
      "visible_if": "{{ block.settings.override_sizes }}"
