

{%- doc -%}
  @param {string} [product_view_context] - Context value passed through to the card snippet.
{%- enddoc -%}

{% liquid
  assign product = closest.product
-%}

{% capture children %}
  {% content_for 'blocks', closest.product: product %}
{% endcapture %}

{% render 'product-card', children: children, product: product, product_view_context: product_view_context %}
{% render 'quantity-selector-styles' %}
{% render 'buy-buttons-styles' %}
{% render 'gift-card-recipient-form-styles' %}
{% render 'quick-add-styles' %}
{% render 'quick-add-modal-styles' %}
{% render 'swatch-styles' %}
{% render 'variant-picker-styles' %}
{% render 'product-badges-styles' %}

{% style %}
  {% if block.settings.apply_custom_style %}
    .product-card--{{ block.id }} {
      position: relative;
    }

    .product-card--{{ block.id }} .product-badges {
      display: none;
    }

    .product-card--{{ block.id }} .product-card-hover-image {
      position: absolute;
      top: 22.5%;
      left: 0px;
      z-index: 1;

      opacity: 0;

      transition: 200ms ease-out;
    }

    .product-card--{{ block.id }} .best-selling-badge {
      position: absolute;
      top: 20px;
      right: 0px;
      background-color: #333332;
      color: white;
      font-size: 12px;
      font-weight: 500;
      padding: 5px 12px 6px 12px;
      border-radius: 8px 0px 0px 8px;
      z-index: 99;

      {% unless product.tags contains 'best_seller' %}
        display: none;
      {% endunless %}
    }

    .product-card--{{ block.id }} .product-media {
      padding: 51px 33px 23px 32px;
      background-color: #131313;
    }

    .product-card--{{ block.id }} .product-media > img {
      z-index: 98;
    }

    .product-card--{{ block.id }} .h4 > p {
      height: 2lh;
    }

    .product-card--{{ block.id }}:hover .product-card-hover-image {
      opacity: 1;
    }

    {% if product.tags contains 'cookbook' %}      
      .product-card--{{ block.id }} .product-media > img {
        filter: grayscale(100%);
        -webkit-filter: grayscale(100%);
      }
  
      .product-card--{{ block.id }}:hover .product-media > img {
        filter: grayscale(0%);
        -webkit-filter: grayscale(0%);
      }
    {% endif %}
  {% endif %}

  {% if block.settings.apply_knife_collection_style %}
    .resource-list__slide:has(.product-card--{{ block.id }}) {
      overflow: visible;
    }

    .product-card--{{ block.id }} {
      overflow: visible;
    }

    .product-card--{{ block.id }} .product-card__content {
      overflow: visible;
    }
    
    .product-card--{{ block.id }} .best-selling-badge {
      display: none;
    }

    .product-card--{{ block.id }} .card-gallery {
      overflow: visible !important;
    }

    .product-card--{{ block.id }} .product-media-container {
      overflow: visible;
      border-radius: 20px;
    }

    .product-card--{{ block.id }} .product-media {
      position: relative;
      padding: none;
    }

    .product-card--{{ block.id }} .product-media img {
      position: absolute;
      left: 0px;
      top: -28px;
    }
  {% endif %}
{% endstyle %}

{% schema %}
{
  "name": "t:names.product_card",
  "blocks": [
    {
      "type": "_product-card-group"
    },
    {
      "type": "text"
    },
    {
      "type": "image"
    },
    {
      "type": "buy-buttons"
    },
    {
      "type": "price"
    },
    {
      "type": "review"
    },
    {
      "type": "sku"
    },
    {
      "type": "swatches"
    },
    {
      "type": "_product-card-gallery"
    },
    {
      "type": "product-title"
    },
    {
      "type": "custom-liquid"
    },
    {
      "type": "@app"
    }
  ],
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "apply_custom_style",
      "label": "Apply Custom Style",
      "info": "Apply Custom Styling to the product card.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "apply_knife_collection_style",
      "label": "Apply Knife Collection Style",
      "info": "Applies the knife accessories collection's style as per design.",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "hover_image",
      "label": "Hover Image",
      "info": "The background image to be shown on card:hover",
      "visible_if": "{{ block.settings.apply_custom_style }}"
    },
    {
      "type": "paragraph",
      "content": "t:content.resource_reference_product_card"
    },
    {
      "type": "range",
      "id": "product_card_gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
