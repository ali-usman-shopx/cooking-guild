{%- doc -%}
    Renders the custom open/close icon.

    @param {string} social_media_type -- Type of Social Media Icon, e.g. facebook, linkedin, twitter

    @example
    {% render 'custom-icon-social-media', social_media_type: social_media_type %}
{%- enddoc -%}

<span class="custom-icon-wrapper">
