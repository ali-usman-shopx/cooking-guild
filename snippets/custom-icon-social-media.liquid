</span>

{% comment %}
    Responsibility for sizing of icon wrapper lies with rendering parent.
{% endcomment %}
{% stylesheet %}
    .custom-icon-wrapper > svg {
        width: 100%;
        height: 100%;
    }

    .custom-icon-wrapper > svg > * {
        transition: 150ms ease-out;
    }

    .custom-icon-wrapper:hover > svg > circle {
        fill: #C09E6F;
    }

    .custom-icon-wrapper:hover > svg > path {
        fill: white;
    }
{% endstylesheet %}
